# Deterministic checks run by integrate.sh and the fix lane before any LLM
# review (D8, D34). Fill in for this repo and commit.
# FACTORY_TEST_CMD is required: the factory refuses to build without it (D44).
# Lint fails integration only on errors new against .factory/lint-baseline.txt
# (D62): after setting it, run scripts/factory/health.sh baseline and commit.
# A one-line output format reads best (eslint -f unix, tsc --pretty false).
FACTORY_LINT_CMD=""
FACTORY_TEST_CMD=""
# Optional third check, e.g. a chart or manifest lint that CI runs:
#   FACTORY_EXTRA_CMD="helm lint --strict charts/<name>"
FACTORY_EXTRA_CMD=""
# Optional: your repo's health tool with its own thresholds, run by the G5
# health check (D50), e.g. complexity and duplication:
#   FACTORY_HEALTH_CMD="npx --yes jscpd src --threshold 3 && lizard -C 10 src"
FACTORY_HEALTH_CMD=""
# Optional: your model gateway's OpenAI-compatible base URL (e.g.
# https://host/v1). The pre-flight checks it is reachable, and doctor.sh probes
# it with each agent's model (served, thinking level, tool turns, quota, D59).
FACTORY_GATEWAY_URL=""
# Name of the environment variable that holds the gateway key (never the key).
FACTORY_GATEWAY_KEY_ENV=""
# Worker worktrees get the installed dependencies (D65): by default the
# worktree hook links node_modules and .venv from this checkout (install
# them here first). Other folders to link, space-separated:
#   FACTORY_DEPS_LINKS="node_modules .venv vendor/bundle"
# Or install per worktree instead of linking (slower, isolated):
#   FACTORY_DEPS_CMD="npm ci --ignore-scripts"
# Self-check as a pi-subagents gate after each worker (D78): a red hand-over
# goes back to the same worker session once, with the failure. Off until
# tried on your setup (needs pi-subagents gate and resume support):
# FACTORY_SELF_CHECK_GATE=1
# Merge request (D86), opened by scripts/factory/mr.sh after /pr:
#   FACTORY_MR_TARGET="production"          # else the remote's default branch
#   FACTORY_MR_BLOCKED_BRANCHES="chore/*"   # branch names that deploy when pushed
#   FACTORY_MR_REVIEWER="jdoe"              # else the spec's **Reviewer:** line (D95)
#   FACTORY_GITLAB_TOKEN_ENV="GITLAB_TOKEN" # name of the variable with an API token (not the token); glab is used first if logged in
# New tests must disagree with the code before the change as the intent says
# (D96): fail there in a feature or bugfix mission, pass there in a maintenance
# or refactor one. One extra test run per ticket with tests; 0 turns it off.
# A ticket opts out with a line "## Test on base: skip — <reason>".
# FACTORY_TEST_ON_BASE=1
# Tickets per wave (D27, D58): 1 or 2 under a small shared quota.
# FACTORY_MAX_PARALLEL=1
